{
  "name": "hpwd",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev",
    "dev:worker": "pnpm --filter @hpwd/worker dev",
    "test": "turbo test",
    "dev:init": "node --env-file=apps/web/.env.local apps/web/scripts/init-bucket.mjs",
    "seed:dev": "pnpm --filter @hpwd/db exec tsx scripts/seed-dev.ts",
    "seed:music": "pnpm --filter @hpwd/db exec tsx scripts/seed-music.ts",
    "seed:templates": "pnpm --filter @hpwd/db exec tsx scripts/seed-templates.ts",
    "backup:db": "pnpm --filter @hpwd/db exec tsx scripts/backup.ts",
    "restore:db": "pnpm --filter @hpwd/db exec tsx scripts/restore.ts"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
