generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime     @default(now())
  invitations   Invitation[]
  assets        MediaAsset[]
  accounts      Account[]
  sessions      Session[]
}

// Auth.js (next-auth v5) PrismaAdapter tables — required to link OAuth
// accounts even though sessions use the JWT strategy.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum InvitationStatus {
  draft
  published
}

enum TemplateTier {
  basic
  premium
}

enum AssetKind {
  image
  audio
  font
}

model Template {
  id           String       @id @default(cuid())
  name         String
  tier         TemplateTier @default(basic)
  category     String       @default("general")
  thumbnailUrl String
  document     Json
  isActive     Boolean      @default(true)
  invitations  Invitation[]
}

model Invitation {
  id                String           @id @default(cuid())
  user              User             @relation(fields: [userId], references: [id])
  userId            String
  slug              String           @unique
  template          Template?        @relation(fields: [templateId], references: [id])
  templateId        String?
  document          Json
  publishedDocument Json?
  status            InvitationStatus @default(draft)
  publishedAt       DateTime?
  settings          Json             @default("{\"showBadge\": true}")
  version           Int              @default(0)
  viewCount         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  guests            Guest[]
  wishes            Wish[]
  submissions       FormSubmission[]
  slugHistory       InvitationSlug[]
  @@index([userId])
}

// Every slug an invitation has ever published under. Publishing under a new
// slug never deletes the old row — it stays forever so (a) the old slug can
// permanently redirect to the current one instead of 404ing, and (b) no
// other invitation can ever claim it out from under the original owner.
// Reclaiming your own historical slug is allowed (see the publish route);
// only a DIFFERENT invitation's history blocks a claim.
model InvitationSlug {
  id           String     @id @default(cuid())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  slug         String     @unique
  createdAt    DateTime   @default(now())
  @@index([invitationId])
}

model Guest {
  id           String     @id @default(cuid())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  name         String
  token        String     @unique @default(cuid())
  group        String?
  note         String?
  viewedAt     DateTime?
  createdAt    DateTime   @default(now())
  @@index([invitationId])
}

model Wish {
  id           String     @id @default(cuid())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  guestName    String
  message      String
  isHidden     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  @@index([invitationId, isHidden])
}

model FormSubmission {
  id           String     @id @default(cuid())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  sectionId    String
  data         Json
  guestToken   String?
  createdAt    DateTime   @default(now())
  @@index([invitationId, sectionId])
}

model MediaAsset {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  kind      AssetKind
  url       String
  meta      Json      @default("{}")
  createdAt DateTime  @default(now())
  @@index([userId, kind])
}

model MusicTrack {
  id       String  @id @default(cuid())
  title    String
  artist   String
  url      String
  duration Int
  category String  @default("general")
  isActive Boolean @default(true)
}
