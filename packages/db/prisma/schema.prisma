generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  image       String?
  createdAt   DateTime     @default(now())
  invitations Invitation[]
  assets      MediaAsset[]
}

enum InvitationStatus {
  draft
  published
}

enum TemplateTier {
  basic
  premium
}

enum AssetKind {
  image
  audio
  font
}

model Template {
  id           String       @id @default(cuid())
  name         String
  tier         TemplateTier @default(basic)
  category     String       @default("general")
  thumbnailUrl String
  document     Json
  isActive     Boolean      @default(true)
  invitations  Invitation[]
}

model Invitation {
  id                String           @id @default(cuid())
  user              User             @relation(fields: [userId], references: [id])
  userId            String
  slug              String           @unique
  template          Template?        @relation(fields: [templateId], references: [id])
  templateId        String?
  document          Json
  publishedDocument Json?
  status            InvitationStatus @default(draft)
  publishedAt       DateTime?
  settings          Json             @default("{\"showBadge\": true}")
  viewCount         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  guests            Guest[]
  wishes            Wish[]
  submissions       FormSubmission[]
  @@index([userId])
}

model Guest {
  id           String     @id @default(cuid())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  name         String
  token        String     @unique @default(cuid())
  group        String?
  note         String?
  viewedAt     DateTime?
  createdAt    DateTime   @default(now())
  @@index([invitationId])
}

model Wish {
  id           String     @id @default(cuid())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  guestName    String
  message      String
  isHidden     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  @@index([invitationId, isHidden])
}

model FormSubmission {
  id           String     @id @default(cuid())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId String
  sectionId    String
  data         Json
  guestToken   String?
  createdAt    DateTime   @default(now())
  @@index([invitationId, sectionId])
}

model MediaAsset {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  kind      AssetKind
  url       String
  meta      Json      @default("{}")
  createdAt DateTime  @default(now())
  @@index([userId, kind])
}

model MusicTrack {
  id       String  @id @default(cuid())
  title    String
  artist   String
  url      String
  duration Int
  category String  @default("general")
  isActive Boolean @default(true)
}
