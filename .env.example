DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hpwd"

# apps/web/src/app/layout.tsx's metadataBase — Next resolves every relative
# URL in page metadata (og:url, the implicit og:image every
# opengraph-image.tsx contributes) against this. `NEXT_PUBLIC_*` vars are
# inlined into the build at BUILD time, not read from the runtime
# environment — a self-hosted/Docker deploy MUST set this in the build
# environment (e.g. as a `docker build --build-arg`/Dockerfile ENV before
# `next build` runs), not just at container/process start, or it has no
# effect at all. PRODUCTION MUST SET THIS to the real public origin (e.g.
# "https://hpwd.vn"), or og:image/og:url silently resolve to
# "http://localhost:3000" and link previews on Zalo/Facebook/iMessage break
# with no build-time warning. Safe to leave unset for local dev — it falls
# back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# For corporate proxy environments, Prisma engine downloads may require:
# NODE_EXTRA_CA_CERTS=.certs/corp-ca.pem (when running prisma commands)

# Redis — used for TWO things: rate-limiting public form/wish submissions
# (apps/web/src/lib/rate-limit.ts) and the BullMQ background job queue shared
# by apps/web (producer) and apps/worker (consumer).
#   docker compose -f docker-compose.dev.yml up -d redis
# Both apps must point at the SAME Redis or enqueued jobs are never consumed.
REDIS_URL="redis://localhost:6379"

# Namespace for every BullMQ key. Leave unset to use bullmq's own "bull"
# default. Set it only when several environments share one Redis instance
# (e.g. staging alongside production) — apps/web and apps/worker MUST agree,
# because a mismatch means the web app enqueues into a queue no worker is
# watching and jobs pile up with no error reported anywhere.
BULLMQ_PREFIX=""

# Background-removal service (services/rembg). apps/worker is the ONLY thing
# that calls it; never expose it to the internet — it takes arbitrary images
# and spends CPU on them with no authentication of its own.
#   cd services/rembg && ./.venv/bin/uvicorn main:app --port 7000
# Only apps/worker reads this. Leave unset to use the default below.
REMBG_URL="http://127.0.0.1:7000"

# Auth.js (next-auth v5) — apps/web/.env.local
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth client — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# C11: @auth/core defaults `trustHost` to false in production unless one of
# AUTH_URL/AUTH_TRUST_HOST is set — without it, Auth.js refuses to trust the
# Host header it's given and Google sign-in fails entirely. REQUIRED when
# self-hosting behind a reverse proxy/CDN (e.g. Cloudflare) that terminates
# TLS and forwards the original Host — set AUTH_TRUST_HOST=true (simplest),
# or AUTH_URL to the exact public origin instead. Not needed on Vercel
# (trustHost is implied there) or for local dev (trustHost defaults to true
# outside production).
AUTH_TRUST_HOST=""
AUTH_URL=""

# Which forwarded header may be believed when deciding WHO a request is from
# (apps/web/src/lib/client-ip.ts) — the rate-limit bucket for wishes and RSVP
# replies depends on getting this right.
#
# `x-forwarded-for` is a list the CALLER can start and each proxy APPENDS to,
# so the trustworthy entries are at the RIGHT-hand end, one per proxy of
# yours. A Web Request carries no peer address, so this cannot be detected —
# the deployment has to say. Pick the line matching your setup:
#
#   app exposed directly, no proxy   TRUSTED_PROXY_HOPS=0
#     Nothing forwarded is believed; every caller shares one bucket. Correct,
#     but one abuser then throttles everyone — do not run this way in public.
#   behind one reverse proxy         TRUSTED_PROXY_HOPS=1   (default, and
#     what docker-compose.prod.yml sets up)
#   Cloudflare in front of it        CLIENT_IP_HEADER=cf-connecting-ip
#     Better than counting hops: Cloudflare OVERWRITES that header on every
#     request rather than appending, so a caller cannot extend it. When set,
#     it is the ONLY header consulted.
#
# Getting this too HIGH costs availability (requests that skip a hop become
# "unknown" and share a bucket); too LOW costs the rate limit entirely,
# silently, because the attacker picks the value.
TRUSTED_PROXY_HOPS="1"
CLIENT_IP_HEADER=""

# Content-Security-Policy (apps/web/src/middleware.ts, lib/csp.ts). The policy
# is built per request, not in next.config.ts, because it has to name the
# R2_PUBLIC_URL origin and `headers()` in next.config.ts is frozen into the
# build output — an image deployed against a different bucket would emit a
# policy that blocks its own photos, with no warning anywhere.
# Set to "true" for the first deploy against real traffic: the browser then
# reports violations to the console instead of enforcing them. Turn it off
# once the console is clean.
CSP_REPORT_ONLY=""

# Object storage (apps/web/src/lib/storage.ts) — Cloudflare R2 in production;
# no R2 account exists yet, so local dev points at a MinIO container instead.
# Both speak the S3 API, so production only needs these values swapped.
#   docker compose -f docker-compose.dev.yml up -d minio
#   pnpm dev:init   (creates the bucket + public-read policy, idempotent)
R2_ENDPOINT="http://localhost:9000"
R2_BUCKET="hpwd"
R2_ACCESS_KEY_ID="minio"
R2_SECRET_ACCESS_KEY="minio12345"
R2_PUBLIC_URL="http://localhost:9000/hpwd"

# Backup (packages/db/scripts/backup.ts, chạy bằng `pnpm backup:db`).
#
# PHẢI là một bucket KHÁC R2_BUCKET, và script sẽ từ chối chạy nếu trùng.
# Bucket media được `init-bucket.mjs` gắn policy cho phép ẩn danh
# `s3:GetObject` trên MỌI key (vì trang thiệp nhúng thẳng URL ảnh/nhạc), nên
# một bản pg_dump nằm trong đó là toàn bộ bảng User, mọi danh sách khách, mọi
# số điện thoại và số tài khoản — ai đoán trúng một tên file là tải được.
# Bucket này KHÔNG được gắn policy công khai.
BACKUP_BUCKET=""
# Số bản giữ lại. Mặc định 14 (spec mục 6).
BACKUP_RETAIN=""
# Đường dẫn tới pg_dump / pg_restore khi chúng không nằm trong PATH
# (vd "/usr/lib/postgresql/16/bin/pg_dump"). Để trống thì dùng PATH.
PG_DUMP_BIN=""
PG_RESTORE_BIN=""

# Same 5 values, copied into packages/db/.env too, are optional for
# `pnpm seed:dev` (packages/db/scripts/seed-dev.ts) — if present, the demo
# invitation's album section gets 4 generated placeholder photos uploaded;
# if absent, the seed still runs but that album section is left empty.
