DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hpwd"

# For corporate proxy environments, Prisma engine downloads may require:
# NODE_EXTRA_CA_CERTS=.certs/corp-ca.pem (when running prisma commands)

# Auth.js (next-auth v5) — apps/web/.env.local
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth client — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
