# Reverse proxy for docker-compose.prod.yml. Caddy obtains and renews a
# Let's Encrypt certificate by itself once {$DOMAIN} resolves to this host.
{$DOMAIN} {
	# MOSTLY INERT, and worth knowing why before someone "fixes" it. Next
	# has `compress: true` by default and gzips every response itself, and
	# Caddy will not re-encode a body that already carries a
	# Content-Encoding — so in practice clients receive Next's gzip and this
	# line only ever applies to anything Caddy serves directly.
	#
	# Leaving it that way is deliberate. Measured over the guest page's
	# initial JavaScript (526,197 bytes uncompressed):
	#
	#     gzip -9    161,710   <- what Next sends today
	#     zstd -3    166,776   Caddy's fast default — BIGGER than gzip
	#     zstd -9    153,490
	#     zstd -19   147,980
	#
	# So switching would need BOTH `compress: false` in next.config.ts and
	# an explicit `encode zstd 9` here; at Caddy's default level it would
	# make responses larger. That pair of changes buys about 8 kB a visit
	# and couples the app's config to this proxy being in front of it —
	# deploy the web container without Caddy after setting it, and every
	# response goes out uncompressed. Not worth it for 5%.
	encode zstd gzip

	reverse_proxy web:3000 {
		# REPLACE, never append. Caddy's default is to preserve whatever
		# X-Forwarded-For the client sent and add to it, which would leave
		# an attacker-chosen value in the list — and `lib/client-ip.ts`
		# counts entries from the right, so a caller could pad the list and
		# push the real entry out of the position the app trusts. With this
		# header set explicitly there is exactly one entry and it is ours,
		# which is what makes TRUSTED_PROXY_HOPS=1 true.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up Host {host}
	}

	# The app sets its own Content-Security-Policy, HSTS, Referrer-Policy
	# and friends per request (apps/web/src/middleware.ts), including a
	# per-request nonce. Nothing is added here: a second, static copy of
	# those headers would either duplicate them or, worse, override the one
	# carrying the nonce and block every script on the page.

	log {
		output stdout
		format json
	}
}
